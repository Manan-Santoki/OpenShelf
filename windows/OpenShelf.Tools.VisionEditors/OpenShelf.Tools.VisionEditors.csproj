<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenShelf.Core\OpenShelf.Core.csproj" />
    <ProjectReference Include="..\OpenShelf.Convert\OpenShelf.Convert.csproj" />
    <ProjectReference Include="..\OpenShelf.Tools\OpenShelf.Tools.csproj" />
    <ProjectReference Include="..\OpenShelf.Vision\OpenShelf.Vision.csproj" />
  </ItemGroup>

  <!-- The 4.6 MB U2-Netp segmentation model (Apache-2.0) is bundled: it is copied to "models" beside every executable that references
       this project, which is where ModelStore looks first. The SHA-256 is pinned in ModelDefinition.U2Netp and checked by the tests. -->
  <ItemGroup>
    <Content Include="models\u2netp.onnx" Link="models\u2netp.onnx" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OpenShelf.Tools.VisionEditors.Tests" />
    <InternalsVisibleTo Include="OpenShelf.Tools.VisionEditors.Demo" />
  </ItemGroup>

</Project>
