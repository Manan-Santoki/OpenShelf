<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>OpenShelf</AssemblyName>
    <RootNamespace>OpenShelf.App</RootNamespace>
    <ApplicationIcon>Assets\OpenShelf.ico</ApplicationIcon>
    <!-- A custom Main (Program.cs) runs Velopack's install/update hooks before WPF starts. -->
    <StartupObject>OpenShelf.App.Program</StartupObject>
    <!-- package.ps1 passes -p:Version=x.y.z; a plain build is a development build. -->
    <Version Condition="'$(Version)' == ''">0.0.0-dev</Version>
    <Product>OpenShelf</Product>
    <Company>OpenShelf</Company>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\OpenShelf.Ui\LICENSE-lucide.txt" Link="LICENSE-lucide.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <!-- WinForms is referenced only for NotifyIcon; keep its namespaces out of scope so WPF names stay unambiguous. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenShelf.Core\OpenShelf.Core.csproj" />
    <ProjectReference Include="..\OpenShelf.Wheel\OpenShelf.Wheel.csproj" />
    <ProjectReference Include="..\OpenShelf.Shelf\OpenShelf.Shelf.csproj" />
    <ProjectReference Include="..\OpenShelf.Settings\OpenShelf.Settings.csproj" />
    <ProjectReference Include="..\OpenShelf.Convert\OpenShelf.Convert.csproj" />
    <ProjectReference Include="..\OpenShelf.Convert.Markdown\OpenShelf.Convert.Markdown.csproj" />
    <ProjectReference Include="..\OpenShelf.Convert.Documents\OpenShelf.Convert.Documents.csproj" />
    <ProjectReference Include="..\OpenShelf.Convert.Media\OpenShelf.Convert.Media.csproj" />
    <ProjectReference Include="..\OpenShelf.Install\OpenShelf.Install.csproj" />
    <ProjectReference Include="..\OpenShelf.Update\OpenShelf.Update.csproj" />
    <ProjectReference Include="..\OpenShelf.Automation\OpenShelf.Automation.csproj" />
    <ProjectReference Include="..\OpenShelf.Tools\OpenShelf.Tools.csproj" />
    <ProjectReference Include="..\OpenShelf.Tools.VisionEditors\OpenShelf.Tools.VisionEditors.csproj" />
    <ProjectReference Include="..\OpenShelf.Tour\OpenShelf.Tour.csproj" />
    <ProjectReference Include="..\OpenShelf.Tools.PdfEditors\OpenShelf.Tools.PdfEditors.csproj" />
    <ProjectReference Include="..\OpenShelf.Tools.MediaEditors\OpenShelf.Tools.MediaEditors.csproj" />
  </ItemGroup>

</Project>
