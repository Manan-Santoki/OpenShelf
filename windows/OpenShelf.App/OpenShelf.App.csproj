<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>OpenShelf</AssemblyName>
    <RootNamespace>OpenShelf.App</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms is referenced only for NotifyIcon; keep its namespaces out of scope so WPF names stay unambiguous. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenShelf.Core\OpenShelf.Core.csproj" />
    <ProjectReference Include="..\OpenShelf.Wheel\OpenShelf.Wheel.csproj" />
    <ProjectReference Include="..\OpenShelf.Shelf\OpenShelf.Shelf.csproj" />
  </ItemGroup>

</Project>
